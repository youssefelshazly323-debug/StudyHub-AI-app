{
  "expo": {
    "name": "StudyHub AI",
    "slug": "studyhub-ai-workspace",
    "version": "2.4.0",
    "scheme": "studyhub-ai",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.studyhub.ai",
      "adaptiveIcon": {
        "backgroundColor": "#2F4EA0"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F4EA0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6017c6d1-9e1a-4dcf-b249-5024aa91d5cd"
      }
    },
    "owner": "youssef1512"
  }
}
