{
  "expo": {
    "name": "StudyHub AI",
    "slug": "studyhub-ai",
    "version": "2.4.0",
    "scheme": "studyhub-ai",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.studyhub.ai",
      "adaptiveIcon": {
        "backgroundColor": "#2F4EA0"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F4EA0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ]
  }
}
